# Spotify — required to use Spotify as your home provider or as a Clone/
# Export/Cherry-pick target. Create an app at developer.spotify.com and add
# http://localhost:8888/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
SPOTIFY_USER_ID=

# Deezer — only needed if you use Deezer as your home provider or as a
# Clone/Export/Cherry-pick target. Register an app at developers.deezer.com,
# then complete Deezer's OAuth authorize redirect once in a browser to get
# an access token (there's no refresh flow — if it expires, repeat this).
DEEZER_ACCESS_TOKEN=
